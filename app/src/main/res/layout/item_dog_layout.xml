<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/dog_list_image_view"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="24dp"
            android:src="@mipmap/ic_launcher"
            app:civ_border_color="#FF000000"
            app:civ_border_width="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dog_breed_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toTopOf="@+id/life_span_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dog_list_image_view"
            app:layout_constraintTop_toTopOf="@+id/dog_list_image_view"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Labrador" />

        <TextView
            android:id="@+id/life_span_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/dog_list_image_view"
            app:layout_constraintEnd_toEndOf="@+id/dog_breed_text_view"
            app:layout_constraintStart_toStartOf="@+id/dog_breed_text_view"
            app:layout_constraintTop_toBottomOf="@+id/dog_breed_text_view"
            tools:text="14 years" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>